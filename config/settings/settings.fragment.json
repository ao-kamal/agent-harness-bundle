{
  "skillListingBudgetFraction": 0.06,
  "model": "glm-5.3-flash",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "& dcg",
            "shell": "powershell"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "python \"C:\\Users\\{{WIN_USER}}\\.claude\\hooks\\post-compact-reminder.py\""
          }
        ]
      }
    ]
  },
  "tui": "fullscreen",
  "modelPicker": {
    "replaceBuiltInOptions": true,
    "options": [
      { "model": "glm-5.3-flash", "label": "GLM-5.3 Flash", "description": "Daily driver - $0.15/$0.50 per 1M - $60/mo cap", "behavesAs": "claude-sonnet-5-5" },
      { "model": "minimax-m3.1-flash", "label": "MiniMax M3.1 Flash", "description": "$0.15/$0.60 per 1M - $20/mo cap", "behavesAs": "claude-sonnet-5-5" },
      { "model": "mimo-v2.6-flash", "label": "MiMo-V2.6-Flash", "description": "Cheapest - $0.14/$0.28 per 1M - $60/mo cap; also the background-tasks slot", "behavesAs": "claude-sonnet-5-5" },
      { "model": "deepseek-v4.1-flash", "label": "DeepSeek V4.1 Flash", "description": "$80/mo cap - off-peak $0.15/peak $0.30 in (peak 01-04, 06-10 UTC Mon-Fri)", "behavesAs": "claude-sonnet-5-5" },
      { "model": "gpt-6-luna", "label": "GPT 6 Luna", "description": "272K ctx - $0.10/$0.50 per 1M - $15/mo cap", "behavesAs": "claude-sonnet-5-5" },
      { "model": "qwen3.7-plus", "label": "Qwen3.7 Plus", "description": "256K ctx - $0.40/$1.60 per 1M - $60/mo cap", "behavesAs": "claude-sonnet-5-5" },
      { "model": "muse-spark-1.3-contributor", "label": "Muse Spark 1.3 Contributor", "description": "$0.10/$0.20 per 1M - trains on prompts; enable in Console privacy; limited regions", "behavesAs": "claude-sonnet-5-5" },
      { "model": "beam-free", "label": "Beam (free, limited time)", "description": "Unlimited while free - docs say not served in Nigeria", "behavesAs": "claude-sonnet-5-5" },
      { "model": "iceman-contributor-free", "label": "Iceman (free, limited time)", "description": "Unlimited while free", "behavesAs": "claude-sonnet-5-5" },
      { "model": "step-5-preview", "label": "Step 5 Preview", "description": "$1.00/$2.70 per 1M - $15/mo cap", "behavesAs": "claude-sonnet-5-5" },
      { "model": "glm-5.3", "label": "GLM-5.3", "description": "Deep reasoning - $1.40/$4.40 per 1M - $15/mo cap (Opus slot)", "behavesAs": "claude-opus-5-5" },
      { "model": "claude-haiku-5-5", "label": "Claude Haiku 5.5", "description": "100K ctx - $0.10/$0.50 per 1M - $15/mo cap" }
    ]
  },
  "env": {
    "DCG_HOOK_TIMEOUT_MS": "2000",
    "ANTHROPIC_BASE_URL": "https://opencode.ai/inference/go/anthropic",
    "ANTHROPIC_AUTH_TOKEN": "oc_sk_PASTE-YOUR-CONSOLE-KEY",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "glm-5.3",
    "ANTHROPIC_DEFAULT_OPUS_MODEL_NAME": "GLM-5.3 (OpenCode Go)",
    "ANTHROPIC_DEFAULT_OPUS_MODEL_DESCRIPTION": "Deep reasoning workhorse - the Opus slot",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "glm-5.3-flash",
    "ANTHROPIC_DEFAULT_SONNET_MODEL_NAME": "GLM-5.3 Flash (OpenCode Go)",
    "ANTHROPIC_DEFAULT_SONNET_MODEL_DESCRIPTION": "Fast daily driver - the Sonnet slot",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "mimo-v2.6-flash",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL_NAME": "MiMo-V2.6-Flash (OpenCode Go)",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL_DESCRIPTION": "Background tasks - $0.14/$0.28 per 1M - $60/mo cap",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1"
  },
  "_hbFragmentVersion": 3,
  "overrideKeys": [
    "env.ANTHROPIC_BASE_URL",
    "env.ANTHROPIC_DEFAULT_OPUS_MODEL",
    "env.ANTHROPIC_DEFAULT_OPUS_MODEL_NAME",
    "env.ANTHROPIC_DEFAULT_OPUS_MODEL_DESCRIPTION",
    "env.ANTHROPIC_DEFAULT_SONNET_MODEL",
    "env.ANTHROPIC_DEFAULT_SONNET_MODEL_NAME",
    "env.ANTHROPIC_DEFAULT_SONNET_MODEL_DESCRIPTION",
    "env.ANTHROPIC_DEFAULT_HAIKU_MODEL",
    "env.ANTHROPIC_DEFAULT_HAIKU_MODEL_NAME",
    "env.ANTHROPIC_DEFAULT_HAIKU_MODEL_DESCRIPTION",
    "env.CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC",
    "modelPicker"
  ],
  "deleteKeys": [
    "env.ANTHROPIC_API_KEY",
    "env.ANTHROPIC_MODEL",
    "env.CLAUDE_CODE_ENABLE_GATEWAY_MODEL_DISCOVERY"
  ]
}
