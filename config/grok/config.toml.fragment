# Merged by install-grok.ps1. Existing keys in ~/.grok/config.toml win.
# Do not add [skills].paths that point at a second copy of the payload.

[ui]
cancel_subagents_on_turn_cancel = "always_stop"

[models]
inference_idle_timeout_secs = 180
max_retries = 3

[toolset.bash]
auto_background_on_timeout = true

[memory]
enabled = true

[compat.claude]
skills = true
rules = true
agents = true
mcps = true
hooks = true

# OpenCode Zen / OpenCode Go Models via local stream filter proxy (127.0.0.1:5210)

# Responses backend (native OpenAI responses stream)
[model.muse-spark-contributor]
model = "muse-spark-1.3-contributor"
base_url = "http://127.0.0.1:5210/v1"
name = "Muse Spark 1.3 Contributor (OpenCode Go)"
api_backend = "responses"
api_key = "sk-OPENCODE-API-KEY-GOES-HERE"
env_key = "OPENCODE_API_KEY"
context_window = 1048576
max_completion_tokens = 131072
supports_reasoning_effort = true
reasoning_efforts = [
  { value = "low", label = "Low Effort", description = "Fast responses with minimal reasoning" },
  { value = "medium", label = "Medium Effort", description = "Balanced effort with standard reasoning" },
  { value = "high", label = "High Effort", description = "Higher quality with extensive reasoning", default = true },
  { value = "xhigh", label = "Extra High Effort", description = "Highest effort and deepest reasoning" }
]

