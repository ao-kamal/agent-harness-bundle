# Merged by install-grok.ps1. Existing keys in ~/.grok/config.toml win.
# Do not add [skills].paths that point at a second copy of the payload.

[memory]
enabled = true

[compat.claude]
skills = true
rules = true
agents = true
mcps = true
hooks = true

# OpenCode Zen (Muse Spark 1.2 Contributor) via local stream filter proxy (127.0.0.1:5210)
[model.muse-spark-contributor]
model = "muse-spark-1.2-contributor"
base_url = "http://127.0.0.1:5210/v1"
name = "Muse Spark 1.2 Contributor (OpenCode Zen)"
api_backend = "responses"
api_key = "sk-local-proxy-stub"
env_key = "OPENCODE_API_KEY"
context_window = 1048576
max_completion_tokens = 131072

[model.deepseek-v4-pro]
model = "deepseek-v4-pro"
base_url = "http://127.0.0.1:5210/v1"
name = "DEEPSEEK-V4-PRO (OpenCode Go)"
api_backend = "responses"
api_key = "sk-local-proxy-stub"
env_key = "OPENCODE_API_KEY"
context_window = 1048576
max_completion_tokens = 131072

[model.kimi-k3]
model = "kimi-k3"
base_url = "http://127.0.0.1:5210/v1"
name = "KIMI-K3 (OpenCode Go)"
api_backend = "responses"
api_key = "sk-local-proxy-stub"
env_key = "OPENCODE_API_KEY"
context_window = 1048576
max_completion_tokens = 131072
