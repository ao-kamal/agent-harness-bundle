{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|run_terminal_command",
        "hooks": [
          {
            "type": "command",
            "command": "python \"C:\\Users\\{{WIN_USER}}\\.grok\\hooks\\trauma_guard.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell|run_terminal_command",
        "hooks": [
          {
            "type": "command",
            "command": "& 'C:\\Users\\{{WIN_USER}}\\.local\\bin\\dcg.exe'",
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"C:\\Users\\{{WIN_USER}}\\.grok\\hooks\\post-compact-reminder.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"C:\\Users\\{{WIN_USER}}\\.grok\\hooks\\post-compact-reminder.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
